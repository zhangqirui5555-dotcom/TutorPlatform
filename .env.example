# Local backend example. Copy to backend/.env for local development.
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tutorplatform?schema=public"
JWT_SECRET="replace_with_a_long_random_secret"
JWT_EXPIRES_IN="1d"
CORS_ORIGINS="http://localhost:5173"
DEMO_SEED_PASSWORD="replace_with_a_separate_demo_password"

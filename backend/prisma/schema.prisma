generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String?   @unique
  phone        String?   @unique
  passwordHash String
  role         String
  status       String    @default("ACTIVE")
  displayName  String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  studentProfile         StudentProfile?
  certifications         Certification[] @relation("StudentCertifications")
  reviewedCertifications Certification[] @relation("CertificationReviewer")
  demands                Demand[]        @relation("ParentDemands")
  applications           Application[]   @relation("StudentApplications")
  parentConversations    Conversation[]  @relation("ParentConversations")
  studentConversations   Conversation[]  @relation("StudentConversations")
  sentMessages           Message[]       @relation("SentMessages")
  receivedMessages       Message[]       @relation("ReceivedMessages")
  parentTrialLessons     TrialLesson[]   @relation("ParentTrialLessons")
  studentTrialLessons    TrialLesson[]   @relation("StudentTrialLessons")
  proposedTrialLessons   TrialLesson[]   @relation("ProposedTrialLessons")
  reviewsWritten         Review[]        @relation("ReviewsWritten")
  reviewsReceived        Review[]        @relation("ReviewsReceived")

  @@index([role, status])
}

model StudentProfile {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  school             String
  major              String
  grade              String
  subjects           String
  teachingExperience String?
  bio                String?
  expectedPriceMin   Int?
  expectedPriceMax   Int?
  priceUnit          String?  @default("PER_HOUR")
  currency           String   @default("CNY")
  teachingRegions    String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Certification {
  id              Int       @id @default(autoincrement())
  studentId       Int
  materialPath    String
  materialType    String
  status          String    @default("PENDING")
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedBy      Int?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student  User  @relation("StudentCertifications", fields: [studentId], references: [id], onDelete: Restrict)
  reviewer User? @relation("CertificationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([studentId, status])
  @@index([status, submittedAt])
  @@index([reviewedBy])
}

model Demand {
  id                  Int       @id @default(autoincrement())
  parentId            Int
  title               String
  childGrade          String
  subject             String
  region              String
  addressDetail       String?
  scheduleDescription String
  budgetMin           Int
  budgetMax           Int
  priceUnit           String    @default("PER_HOUR")
  currency            String    @default("CNY")
  description         String?
  status              String    @default("DRAFT")
  publishedAt         DateTime?
  matchedAt           DateTime?
  completedAt         DateTime?
  closedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  parent       User          @relation("ParentDemands", fields: [parentId], references: [id], onDelete: Restrict)
  applications Application[]
  conversation Conversation?
  trialLessons TrialLesson[]

  @@index([parentId, status])
  @@index([status, subject, region, publishedAt])
}

model Application {
  id           Int       @id @default(autoincrement())
  studentId    Int
  demandId     Int
  coverMessage String
  status       String    @default("PENDING")
  viewedAt     DateTime?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student      User          @relation("StudentApplications", fields: [studentId], references: [id], onDelete: Restrict)
  demand       Demand        @relation(fields: [demandId], references: [id], onDelete: Restrict)
  conversation Conversation?
  trialLessons TrialLesson[]

  @@unique([studentId, demandId])
  @@index([demandId, status, createdAt])
  @@index([studentId, status, createdAt])
}

model Conversation {
  id            Int       @id @default(autoincrement())
  applicationId Int       @unique
  demandId      Int       @unique
  parentId      Int
  studentId     Int
  status        String    @default("ACTIVE")
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  demand      Demand      @relation(fields: [demandId], references: [id], onDelete: Restrict)
  parent      User        @relation("ParentConversations", fields: [parentId], references: [id], onDelete: Restrict)
  student     User        @relation("StudentConversations", fields: [studentId], references: [id], onDelete: Restrict)
  messages    Message[]

  @@index([parentId, status, lastMessageAt])
  @@index([studentId, status, lastMessageAt])
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int
  senderId       Int
  receiverId     Int
  content        String
  messageType    String    @default("TEXT")
  sentAt         DateTime  @default(now())
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)
  receiver     User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Restrict)

  @@index([conversationId, sentAt, id])
  @@index([receiverId, readAt])
  @@index([senderId])
}

model TrialLesson {
  id                 Int       @id @default(autoincrement())
  applicationId      Int
  demandId           Int
  parentId           Int
  studentId          Int
  proposedBy         Int
  scheduledStartAt   DateTime
  scheduledEndAt     DateTime
  method             String
  locationOrLink     String?
  status             String    @default("PENDING_CONFIRMATION")
  cancellationReason String?
  confirmedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  demand      Demand      @relation(fields: [demandId], references: [id], onDelete: Restrict)
  parent      User        @relation("ParentTrialLessons", fields: [parentId], references: [id], onDelete: Restrict)
  student     User        @relation("StudentTrialLessons", fields: [studentId], references: [id], onDelete: Restrict)
  proposer    User        @relation("ProposedTrialLessons", fields: [proposedBy], references: [id], onDelete: Restrict)
  reviews     Review[]

  @@index([applicationId, status])
  @@index([demandId])
  @@index([parentId, status, scheduledStartAt])
  @@index([studentId, status, scheduledStartAt])
  @@index([proposedBy])
}

model Review {
  id            Int      @id @default(autoincrement())
  trialLessonId Int
  reviewerId    Int
  revieweeId    Int
  rating        Int
  content       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trialLesson TrialLesson @relation(fields: [trialLessonId], references: [id], onDelete: Restrict)
  reviewer    User        @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewee    User        @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Restrict)

  @@unique([trialLessonId, reviewerId])
  @@index([revieweeId, createdAt])
  @@index([reviewerId, createdAt])
}

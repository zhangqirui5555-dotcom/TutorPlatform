# Railway injects PORT automatically.
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tutorplatform?schema=public"
JWT_SECRET="replace_with_at_least_32_random_characters"
JWT_EXPIRES_IN="1d"
# Positive integer used when an administrator lists a demand without expires_at.
DEFAULT_DEMAND_EXPIRE_DAYS=30
# Comma-separated, without trailing slashes.
CORS_ORIGINS="http://localhost:5173,https://your-project.vercel.app"
# Only required when running `npm run prisma:seed`.
ALLOW_DEMO_SEED=false
DEMO_SEED_PASSWORD="replace_with_a_separate_demo_password"
